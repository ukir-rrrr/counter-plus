# RevenueCat の公開APIキー（Secret ではない）。実キーは .env か EAS に置き、コミットしない
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob。App ID はビルド時、バナーユニットIDは実行時に読む。実値はコミットしない
# 開発中のバナーはコード側で Google のテスト広告IDを使う。production にはテストIDを入れない
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=

# PostHog。プロジェクトAPIキー（phc_ で始まる）。ホストは Cloud ならそのままでよい
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 設定の外部リンク。App Store Connect でアプリを作ったあとの数字 ID と、問い合わせ用メール
EXPO_PUBLIC_APP_STORE_ID=
# 例（本番も同じ）: aba929559@gmail.com 。EAS の各環境にも入れる
EXPO_PUBLIC_SUPPORT_EMAIL=aba929559@gmail.com
